{
  "name": "flotti",
  "version": "0.1.0",
  "main": "build/index.js",
  "bin": {
    "flotti": "build/index.js"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc && vite build --config web/vite.config.ts",
    "prepack": "npm run build",
    "dev:web": "vite --config web/vite.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc -p web/tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js",
    "test:e2e": "npm run build && tsc -p tsconfig.test.json && playwright test -c e2e/playwright.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micromagicman/flotti.git"
  },
  "keywords": [
    "supervisor",
    "ai-agent",
    "codex",
    "claude"
  ],
  "author": "micromagicman",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/micromagicman/flotti/issues"
  },
  "homepage": "https://github.com/micromagicman/flotti#readme",
  "description": "Simple ai agents orchestrator for humans",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.2.0",
    "@agentclientprotocol/sdk": "^1.5.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
